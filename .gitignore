# OS
.DS_Store
Thumbs.db

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
/dist/
/build/

# Node
node_modules/

# Credentials — never commit
.env
secrets.local.yaml
litellm.yaml

# Runtime data — generated at runtime, not source
*.db
logs/
.runtime/
data/

# Large binary files — not useful in git history
*.pptx
*.key
*.p12

# Editor
.idea/
.vscode/
*.swp

# Generated secrets (encryption key / session secret) — never commit or bake into images
.settings.key
.session_secret
