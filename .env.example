# NetCopilot — Environment Configuration
# Copy to .env and fill in values. Never commit .env to git.

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai                    # openai | anthropic | local
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=                     # optional — only if LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_WORKSPACE_ID=                # wrkspc_... — only needed if the API key is not scoped to a workspace
ANTHROPIC_EFFORT=medium                # low | medium | high | xhigh | max (Opus 5.5 default: medium)
ANTHROPIC_MAX_TOKENS=16000             # per call; thinking counts toward it
ANTHROPIC_FALLBACK=auto                # retry policy declines on a fallback model (auto = Opus 5.x / Fable 5.x)

# ---------------------------------------------------------------------------
# Auth0 (SSO)
# ---------------------------------------------------------------------------
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=https://your-tenant.auth0.com/api/v2/
SESSION_SECRET=                        # 16+ random chars; if unset a random secret is generated in the data dir

# ---------------------------------------------------------------------------
# Access control & guardrails (see docs/SECURITY.md)
# ---------------------------------------------------------------------------
# Without Auth0 or API keys, only requests from this machine (127.0.0.1) are served.
NETCOPILOT_API_KEYS=                   # "key1:admin,key2:noc,key3:noc-ticket"
ALLOW_ANONYMOUS_ACCESS=false           # true = anyone who can reach the port is admin (trusted lab only)
NETCOPILOT_ENCRYPTION_KEY=             # Fernet key for credentials saved in the Admin UI (else a key file is generated).
                                       # Changing it makes previously saved secrets unreadable — re-enter them.
NETCOPILOT_LOCK_GUARDRAILS=false       # true = security settings only from env, not editable in the Admin UI
REDACT_DEVICE_SECRETS=true             # mask passwords/keys/communities in device output before the LLM
SSH_STRICT_HOST_KEY_CHECKING=false     # true = reject unknown device host keys (needs a known_hosts file)
SSH_KNOWN_HOSTS_FILE=~/.ssh/known_hosts
SESSION_COOKIE_SECURE=false            # true when served over HTTPS
AUDIT_RETENTION_DAYS=90
HISTORY_RETENTION_DAYS=90              # investigation history (questions, answers, redacted evidence)
METRICS_TOKEN=                         # if set, /metrics requires "Authorization: Bearer <token>"
ALLOWED_ORIGINS=                       # extra browser origins allowed to POST (e.g. behind a different hostname)
ENABLE_API_DOCS=true                   # /docs and /redoc

# ---------------------------------------------------------------------------
# Device credentials
# ---------------------------------------------------------------------------
JUNIPER_USER=netops
JUNIPER_PASS=
CISCO_USER=netops
CISCO_PASS=
NOKIA_USER=admin
NOKIA_PASS=
ARUBA_USER=admin
ARUBA_PASS=
NETCONF_PORT=830
NETCONF_TIMEOUT=30

# ---------------------------------------------------------------------------
# Jira
# ---------------------------------------------------------------------------
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=netcopilot@yourcompany.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=NOC

# ---------------------------------------------------------------------------
# Slack
# ---------------------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_ALERT_CHANNEL=#noc-alerts

# ---------------------------------------------------------------------------
# Microsoft Teams (outgoing webhook)
# ---------------------------------------------------------------------------
TEAMS_HMAC_SECRET=                     # security token shown when creating the outgoing webhook
TEAMS_RESULT_WEBHOOK_URL=              # Workflows "post to channel" webhook for answers that take >5s

# ---------------------------------------------------------------------------
# Prometheus / Syslog backends
# ---------------------------------------------------------------------------
PROMETHEUS_URL=http://prometheus:9090
SYSLOG_URL=http://loki:3100            # Loki base URL (auto-detected) or a generic HTTP search endpoint
SYSLOG_TOKEN=
SYSLOG_BACKEND=                        # loki | generic (default: inferred from the URL)
SYSLOG_LOKI_DEVICE_LABEL=host          # Loki label holding the device name
SYSLOG_LOKI_SELECTOR={job=~".+"}       # stream selector for searches not tied to a device
SYSLOG_LOKI_TENANT=                    # X-Scope-OrgID for multi-tenant Loki
SYSLOG_DEFAULT_HOURS=24                # default search window

# ---------------------------------------------------------------------------
# Alerts (POST /alerts/ingest or Alertmanager webhook POST /alerts/alertmanager)
# ---------------------------------------------------------------------------
ALERT_INGEST_TOKEN=                    # sent as X-Alert-Token or "Authorization: Bearer <token>"
AUTO_INVESTIGATE=false                 # investigate new alerts automatically and reply in the Slack thread
AUTO_INVESTIGATE_ROLE=noc              # read-only role (cannot create tickets)
AUTO_INVESTIGATE_MAX_PER_HOUR=20       # LLM cost cap
ALERT_DEDUPE_MINUTES=30                # don't re-investigate the same alert within this window

# ---------------------------------------------------------------------------
# HashiCorp Vault (optional — replaces credential env vars above)
# ---------------------------------------------------------------------------
VAULT_ADDR=                            # e.g. https://vault.yourcompany.com
VAULT_TOKEN=                           # or use AppRole below
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_SECRET_PATH=secret/netcopilot

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_PORT=8001
NETCOPILOT_DATA_DIR=                   # where settings/memory/alerts/playbooks .db files live (Docker: /app/data)
TOOL_RESULT_MAX_CHARS=24000            # per tool result sent to the LLM; larger CLI output is truncated
NETBOX_MANUFACTURER_ARUBA=Aruba        # manufacturer name used to discover Aruba devices in NetBox
